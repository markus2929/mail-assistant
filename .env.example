# Copy to .env (never commit). Non-secret settings only; secrets live in ./secrets/.
# Lines marked (required) must be filled in; everything else has a working default.

# --- You ---
TIMEZONE=Europe/Amsterdam
MY_ADDRESSES=me@example.com,info@example-business.com,orders@example-business.com   # (required) all your own addresses

# --- Proton Bridge (required) ---
# Proton Bridge on this machine. Username = your Proton address; the password is the
# Bridge-generated IMAP password in secrets/imap_password (NOT your Proton password).
IMAP_HOST=127.0.0.1                # home server: bridge
IMAP_PORT=1143                     # home server: 1144
IMAP_USERNAME=me@example.com       # (required)

# Pin Bridge's TLS certificate (fingerprint printed by scripts/imap_probe.py). Required.
BRIDGE_CERT_SHA256=                # (required)

# Mailboxes to synchronise (comma-separated fnmatch patterns). Labels/*, All Mail, Drafts, Spam,
# Trash and Starred are not synced: every message lives in exactly one of these folders.
SYNC_INCLUDE=INBOX,Sent,Archive,Folders/*
SYNC_EXCLUDE=Folders

# Extra IMAP accounts (python -m mailassistant.mail.accounts): first sync goes back this many days.
MAIL_BACKFILL_DAYS=60
# Microsoft 365 / Outlook.com accounts: Application (client) ID of your own app registration
# (docs/MICROSOFT_SETUP.md). No secret needed. Tenant "common" = work/school and personal accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT=common

# "Ads" is a Proton *label* (Labels/Ads), not a folder. Target of archive suggestions (never applied automatically).
FOLDER_NEWSLETTERS=Labels/Ads
FOLDER_SENT=Sent
FOLDER_ARCHIVE=Archive

# --- Which layout (docker compose reads this) ---
# Everything on one machine with the Bridge app and Ollama: uncomment. Home server: leave it out
# (docker-compose.yml) and see docs/SERVER_SETUP.md.
# COMPOSE_FILE=docker-compose.single-host.yml

# --- Local AI model (Ollama) ---
# Home server: OLLAMA_BASE_URL=https://<desktop>:11435, OLLAMA_CERT_SHA256=<proxy fingerprint>, token in
# secrets/ollama_token (see docs/SERVER_SETUP.md).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CERT_SHA256=
OLLAMA_MODEL=qwen3:14b             # classification; a smaller/faster model also works here
OLLAMA_NUM_CTX=8192                # context window requested per call
LLM_LOG_RETENTION_DAYS=14
# Optional fallback Ollama, used only while the one above is unreachable (e.g. a small CPU model on the home
# server: COMPOSE_PROFILES=server-llm starts it; see docs/SERVER_SETUP.md). One model for every task there.
# COMPOSE_PROFILES=server-llm
OLLAMA_FALLBACK_URL=               # e.g. http://mailassistant-ollama:11434
OLLAMA_FALLBACK_MODEL=             # e.g. a ~4B model; pick it with the evaluations (README "Choosing models")
OLLAMA_FALLBACK_TIMEOUT_SECONDS=600
# OLLAMA_SERVER_CPUS=3             # limits of the server Ollama container
# OLLAMA_SERVER_MEMORY=6g

# --- Dashboard ---
WEB_HOST=0.0.0.0                   # dashboard on the LAN (HTTPS required); 127.0.0.1 = this desktop only
WEB_PORT=8443
# WEB_PUBLISH_PORT=8444           # home-server layout: outside port if 8443 is already used (e.g. by a UniFi controller)
WEB_TLS=self                       # self (certificate from web.makecert) | proxy | off (loopback only)
WEB_ALLOWED_HOSTS=localhost,127.0.0.1   # makecert prints the line to use (host names + LAN address)
WEB_REMEMBER_DAYS=90               # "keep me signed in on this device" on the login page
DASHBOARD_URL=                     # e.g. https://desktop.local:8443 (used in notifications)

# --- Classification ---
CLASSIFY_WINDOW_DAYS=60            # only mail newer than this is classified (0 = pause)
CLASSIFY_MIN_CONFIDENCE=0.6        # below this a message goes to manual review
CLASSIFY_ARCHIVE_CONFIDENCE=0.85   # needed before an archive suggestion is made
LLM_LOG_PROMPTS=true               # keep prompts/responses in llm_calls (purged after LLM_LOG_RETENTION_DAYS)
# Free text added to the prompt - please edit; this one is an assumption based on your addresses:
CLASSIFY_CONTEXT=Mail addressed to info@example-business.com or orders@example-business.com is business mail (work). Mail to me@example.com can be personal or work.

# --- Follow-ups and daily briefing ---
FOLLOWUP_WINDOW_DAYS=30            # only mail newer than this is scanned for commitments (0 = pause)
FOLLOWUP_OLLAMA_MODEL=qwen3:14b    # needs a careful model; small models produce false follow-ups
FOLLOWUP_MIN_CONFIDENCE=0.6        # extracted commitments below this are dropped
FOLLOWUP_CLOSE_MIN_CONFIDENCE=0.7  # needed before a closure is proposed (never applied without you)
FOLLOWUP_ESTIMATE_DAYS_I_OWE=2     # working days until a reminder when no deadline is stated
FOLLOWUP_ESTIMATE_DAYS_THEY_OWE=5
FOLLOWUP_REMIND_HOUR=8             # local hour reminders fall due
BRIEFING_HOUR=7                    # the daily briefing is built from this local hour on

# --- Home Assistant notifications (optional; empty HA_URL = off) ---
HA_URL=                            # e.g. http://homeassistant.local:8123
HA_NOTIFY_SERVICE=                 # e.g. mobile_app_pixel_8 (Developer tools > Actions > notify.*)
HA_CA_FILE=                        # only if HA uses a self-signed certificate
HA_NOTIFY_DETAIL=counts            # counts (numbers + link; push passes Google/Apple servers) | full (adds short texts)
# token: secrets/ha_token (long-lived access token; leave the file empty when HA is not used)

# --- Google Calendar (optional; see docs/GOOGLE_SETUP.md) ---
# Calendars: give a NAME as shown in Google Calendar (e.g. Familie) or an ID (Settings > Integrate calendar >
# Calendar ID). Names need the calendar-list permission (docs/GOOGLE_SETUP.md). `gcal calendars` lists yours.
GOOGLE_WORK_CALENDAR=primary       # work appointments are created here
GOOGLE_PRIVATE_CALENDAR=           # private appointments; empty = one calendar for everything
# Conflict checks: empty = all calendars you own; `none` = only work + private; or a comma-separated list of
# names/IDs = work + private + exactly these (e.g. Family,Club). Use the ID for a name containing a comma.
GOOGLE_CONFLICT_CALENDARS=
CALENDAR_WORK_ADDRESSES=info@example-business.com,orders@example-business.com   # invitations to these are suggested for work

# --- Adding things yourself (dashboard "Add" page, Home Assistant Assist, mail to yourself) ---
# Mail you send to one of these addresses becomes a proposal. +agenda/+afspraak = appointment,
# +todo/+followup = follow-up, other tags = decide automatically. Proton delivers plus-addresses to your inbox.
CAPTURE_ADDRESSES=me+agenda@example.com,me+todo@example.com
# Voice via Home Assistant Assist: token in secrets/capture_token (empty file = off), see docs/HOME_ASSISTANT.md
CAPTURE_WAIT_SECONDS=20            # how long Assist waits for the result to read back
CAPTURE_VOICE_FOLLOWUP_MODEL=      # faster model for SPOKEN follow-ups (e.g. the classification model, so no
                                   # model swap); empty = FOLLOWUP_OLLAMA_MODEL. The task text is always your own words.
